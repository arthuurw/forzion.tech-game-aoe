# Avisos de ordem recusada, um por motivo de recusa da simulação.
msgid "ORDER_REJECTED_UNKNOWN_PLAYER"
msgstr "Ordem recusada: Jogador desconhecido."

msgid "ORDER_REJECTED_DEFEATED_PLAYER"
msgstr "Ordem recusada: você já foi derrotado."

msgid "ORDER_REJECTED_UNKNOWN_UNIT"
msgstr "Ordem recusada: a unidade não está mais no mapa."

msgid "ORDER_REJECTED_UNIT_OF_ANOTHER_PLAYER"
msgstr "Ordem recusada: essa unidade é de outro Jogador."

msgid "ORDER_REJECTED_DESTINATION_OUTSIDE_MAP"
msgstr "Ordem recusada: o destino fica fora do mapa."

msgid "ORDER_REJECTED_UNKNOWN_RESOURCE_SOURCE"
msgstr "Ordem recusada: a Fonte de Recurso não está mais no mapa."

msgid "ORDER_REJECTED_UNKNOWN_TARGET"
msgstr "Ordem recusada: o alvo não está mais no mapa."

msgid "ORDER_REJECTED_OWN_TARGET"
msgstr "Ordem recusada: não dá para atacar o que é seu."

msgid "ORDER_REJECTED_UNIT_CANNOT_ATTACK"
msgstr "Ordem recusada: só unidades militares atacam."

msgid "ORDER_REJECTED_UNIT_CANNOT_GATHER"
msgstr "Ordem recusada: só Aldeões coletam."

msgid "ORDER_REJECTED_UNKNOWN_BUILDING"
msgstr "Ordem recusada: a construção não está mais no mapa."

msgid "ORDER_REJECTED_BUILDING_OF_ANOTHER_PLAYER"
msgstr "Ordem recusada: essa construção é de outro Jogador."

msgid "ORDER_REJECTED_BUILDING_ALREADY_COMPLETE"
msgstr "Ordem recusada: essa construção já está pronta."

msgid "ORDER_REJECTED_BUILDING_NOT_PLACEABLE"
msgstr "Ordem recusada: essa construção não pode ser posicionada."

msgid "ORDER_REJECTED_INVALID_PLACEMENT"
msgstr "Ordem recusada: o local não está livre."

msgid "ORDER_REJECTED_NOT_ENOUGH_RESOURCES"
msgstr "Ordem recusada: faltam Recursos."

msgid "ORDER_REJECTED_UNIT_CANNOT_BUILD"
msgstr "Ordem recusada: só Aldeões constroem."

msgid "ORDER_REJECTED_BUILDING_NOT_COMPLETE"
msgstr "Ordem recusada: a construção ainda não está pronta."

msgid "ORDER_REJECTED_BUILDING_CANNOT_TRAIN_UNIT"
msgstr "Ordem recusada: essa construção não treina essa unidade."

msgid "ORDER_REJECTED_NOT_IN_TRAINING_QUEUE"
msgstr "Ordem recusada: essa unidade não está mais na fila de treino."

msgid "ORDER_REJECTED_POPULATION_LIMIT_REACHED"
msgstr "Ordem recusada: a população chegou ao limite. Construa mais Casas."

msgid "ORDER_REJECTED_BUILDING_CANNOT_TRAIN"
msgstr "Ordem recusada: essa construção não treina unidades."

msgid "ORDER_REJECTED_BUILDING_CANNOT_ADVANCE_AGE"
msgstr "Ordem recusada: só o Centro faz o Avanço de Era."

msgid "ORDER_REJECTED_AGE_ADVANCE_IN_PROGRESS"
msgstr "Ordem recusada: o Avanço de Era já está em andamento."

msgid "ORDER_REJECTED_LAST_AGE_REACHED"
msgstr "Ordem recusada: você já está na última Era."

msgid "ORDER_REJECTED_UNIT_LOCKED"
msgstr "Ordem recusada: sua Era ainda não liberou essa unidade."

msgid "ORDER_REJECTED_BUILDING_LOCKED"
msgstr "Ordem recusada: sua Era ainda não liberou essa construção."

